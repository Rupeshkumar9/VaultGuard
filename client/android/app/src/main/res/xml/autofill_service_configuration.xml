<?xml version="1.0" encoding="utf-8"?>
<autofill-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.vaultguard.app.MainActivity"
    android:supportsInlineSuggestions="true">

    <!--
      Browser compatibility mode lets Android build an AssistStructure from the
      accessibility virtual view tree when a browser does not expose web fields
      through the native Autofill API. Keep modern Brave on its native third-party
      autofill integration; forcing Chromium's legacy path on newer builds can be
      unstable. Opera still requires the compatibility fallback.
    -->
    <compatibility-package
        android:name="com.brave.browser"
        android:maxLongVersionCode="427912623" />
    <compatibility-package
        android:name="com.opera.browser"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.opera.browser.beta"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.opera.mini.native"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.opera.mini.native.beta"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.opera.gx"
        android:maxLongVersionCode="10000000000" />
</autofill-service>
